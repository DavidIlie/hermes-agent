FROM docker.io/nousresearch/hermes-agent@sha256:444b42594e7f467425872fc35e077a227d377f0fe0726bc818706d62175fad8b

COPY --chown=root:root --chmod=0644 gateway/platforms/base.py /opt/hermes/gateway/platforms/base.py
COPY --chown=root:root --chmod=0644 gateway/response_filters.py /opt/hermes/gateway/response_filters.py
COPY --chown=root:root --chmod=0644 gateway/run.py /opt/hermes/gateway/run.py
COPY --chown=root:root --chmod=0644 gateway/run_adapters.py /opt/hermes/gateway/run_adapters.py
COPY --chown=root:root --chmod=0644 gateway/run_busy.py /opt/hermes/gateway/run_busy.py
COPY --chown=root:root --chmod=0644 gateway/run_inbound.py /opt/hermes/gateway/run_inbound.py
COPY --chown=root:root --chmod=0644 gateway/run_turn.py /opt/hermes/gateway/run_turn.py
COPY --chown=root:root --chmod=0644 gateway/run_turn_runner.py /opt/hermes/gateway/run_turn_runner.py
COPY --chown=root:root --chmod=0644 gateway/session_context.py /opt/hermes/gateway/session_context.py
COPY --chown=root:root --chmod=0644 gateway/turn_context.py /opt/hermes/gateway/turn_context.py
COPY --chown=root:root --chmod=0644 plugins/platforms/discord/adapter.py /opt/hermes/plugins/platforms/discord/adapter.py
COPY --chown=root:root --chmod=0644 plugins/platforms/discord/adapter_component_auth.py /opt/hermes/plugins/platforms/discord/adapter_component_auth.py
COPY --chown=root:root --chmod=0644 plugins/platforms/discord/adapter_media.py /opt/hermes/plugins/platforms/discord/adapter_media.py
COPY --chown=root:root --chmod=0644 plugins/platforms/discord/adapter_slash_auth.py /opt/hermes/plugins/platforms/discord/adapter_slash_auth.py
COPY --chown=root:root --chmod=0644 plugins/platforms/discord/friend_code_approval.py /opt/hermes/plugins/platforms/discord/friend_code_approval.py
COPY --chown=root:root --chmod=0644 tools/approval_prompt.py /opt/hermes/tools/approval_prompt.py
COPY --chown=root:root --chmod=0644 tools/clarify_gateway.py /opt/hermes/tools/clarify_gateway.py
COPY --chown=root:root --chmod=0644 tools/mcp_tool.py /opt/hermes/tools/mcp_tool.py
COPY --chown=root:root --chmod=0644 tools/mcp_tool_handlers.py /opt/hermes/tools/mcp_tool_handlers.py
COPY --chown=root:root --chmod=0644 tools/mcp_tool_provenance.py /opt/hermes/tools/mcp_tool_provenance.py
COPY --chown=root:root --chmod=0644 tools/mcp_tool_registration.py /opt/hermes/tools/mcp_tool_registration.py
COPY --chown=root:root --chmod=0644 tools/mcp_tool_schema.py /opt/hermes/tools/mcp_tool_schema.py
COPY --chown=root:root --chmod=0644 tools/slash_confirm.py /opt/hermes/tools/slash_confirm.py

ARG HERMES_GIT_SHA
RUN test -n "$HERMES_GIT_SHA" && printf '%s\n' "$HERMES_GIT_SHA" > /opt/hermes/.hermes_build_sha
LABEL org.opencontainers.image.revision=$HERMES_GIT_SHA
