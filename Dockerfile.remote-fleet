# Remote Fleet overlay for the released Hermes Agent image.
#
# Keep the heavyweight, reproducible upstream image intact and replace only
# the tested gateway module that adds the bounded operator-replay recovery
# reason. The base is pinned by digest; no package install or mutable download
# occurs in this overlay build.
FROM docker.io/nousresearch/hermes-agent@sha256:68e15ae2a6d894d0ccbd9f8aacbbe13d4d28fa5dc9b6a303970b67bb2499b1a6

COPY --chown=root:root --chmod=0644 gateway/run.py /opt/hermes/gateway/run.py
COPY --chown=root:root --chmod=0644 tools/mcp_tool.py /opt/hermes/tools/mcp_tool.py
